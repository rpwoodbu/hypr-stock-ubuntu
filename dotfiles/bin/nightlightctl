#!/usr/bin/env bash
# Control wlsunset color temperature + status output for Waybar.
# Usage: nightlightctl [restore|on|off|status]  (no arg = toggle)

set -euo pipefail

# Single source of truth for color temperature
TEMP=5400
# wlsunset requires daytime temp (-T) to be greater than nighttime (-t).
DAYTIME_TEMP=$((TEMP + 1))
# A state file is needed to remember between sessions whether the nightlight was
# last enabled.
STATE_FILE="$HOME/.local/state/nightlight-enabled"

is_running() {
    pgrep -x wlsunset >/dev/null
}

# The night light is considered enabled if the state file indicates it should be
# active. This prevents a race condition on login where Waybar queries status
# before restore finishes launching wlsunset.
is_enabled() {
    [ -f "$STATE_FILE" ]
}

print_status() {
    if is_enabled; then
        echo '{"text": "", "class": "active", "tooltip": "Night Light: enabled"}'
    else
        echo '{"text": "", "class": "inactive", "tooltip": "Night Light: disabled"}'
    fi
}

notify() {
    swayosd-client --custom-message "$1" --custom-icon "$2" 2>/dev/null || true
}

start_nightlight() {
    if ! is_running; then
        wlsunset -t "$TEMP" -T "$DAYTIME_TEMP" >/dev/null 2>&1 &
    fi
    mkdir -p "$(dirname "$STATE_FILE")"
    touch "$STATE_FILE"
}

stop_nightlight() {
    pkill -x wlsunset 2>/dev/null || true
    rm -f "$STATE_FILE"
}

update_waybar() {
    # Signal Waybar (via SIGRTMIN+8) to immediately refresh the
    # custom/nightlight icon without polling.
    pkill -RTMIN+8 waybar 2>/dev/null || true
}

case "${1:-}" in
    status)
        print_status
        ;;
    restore)
        # Called on login and on resume from suspend (via hypridle's
        # after_sleep_cmd). Only start if it was enabled when last used.
        if is_enabled; then
            start_nightlight
        fi
        # Don't call update_waybar here as it might not be ready to handle the
        # configured signal for updating the nightlight module, and that
        # unhandled signal has been observed to terminate waybar.
        ;;
    on)
        start_nightlight
        notify "Night Light: On (${TEMP}K)" "weather-clear-night"
        update_waybar
        ;;
    off)
        stop_nightlight
        notify "Night Light: Off" "weather-clear"
        update_waybar
        ;;
    *)
        # Default to the toggle action.
        if is_enabled; then
            stop_nightlight
            notify "Night Light: Off" "weather-clear"
        else
            start_nightlight
            notify "Night Light: On (${TEMP}K)" "weather-clear-night"
        fi
        update_waybar
        ;;
esac

